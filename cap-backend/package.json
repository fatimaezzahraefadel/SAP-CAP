{
  "name": "cap-backend",
  "version": "1.0.0",
  "description": "SAP CAP OData v4 backend – Performance Management Platform",
  "main": "server.js",
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "dev:web": "npm run dev --prefix app/frontend",
    "dev:all": "node scripts/dev-all.js",
    "build:web": "npm run build --prefix app/frontend",
    "sync:approuter": "node scripts/sync-approuter-resources.js",
    "build": "npm run build:web && npm run sync:approuter && cds build --production",
    "lint": "eslint .",
    "test": "jest --config jest.config.cjs --forceExit --detectOpenHandles"
  },
  "dependencies": {
    "@cap-js/hana": "^1",
    "@cap-js/mcp-server": "^0.0.5",
    "@cap-js/sqlite": "^1",
    "@sap/cds": "^8",
    "@sap/xsenv": "^5",
    "@sap/xssec": "^4",
    "node-cron": "^3.0.2",
    "passport": "^0.7.0"
  },
  "overrides": {
    "better-sqlite3": "^12.2.0"
  },
  "devDependencies": {
    "@sap/cds-dk": "^8",
    "@types/jest": "^30.0.0",
    "axios": "^1.13.5",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "chai-subset": "^1.6.0",
    "eslint": "^9.39.3",
    "jest": "^29.7.0"
  },
  "cds": {
    "requires": {
      "auth": "mocked",
      "db": {
        "kind": "sqlite",
        "credentials": {
          "database": "db/performance.db"
        }
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        },
        "db": {
          "kind": "hana-cloud"
        }
      },
      "[hybrid]": {
        "auth": {
          "kind": "xsuaa"
        }
      }
    }
  }
}
