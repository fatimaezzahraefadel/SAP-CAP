# Ignore rules for the monolithic CAP app

# Dependencies
node_modules/

# Build output
gen/
dist/
build/
app/approuter/resources/*
!app/approuter/resources/.gitkeep
!app/approuter/resources/assets/
app/approuter/resources/assets/*
!app/approuter/resources/assets/.gitkeep

# SQLite database (runtime artifact - seed via cds deploy)
*.db
*.sqlite
*.sqlite-*
*.db-journal
*.db-wal
*.db-shm
db/*.db
db/*.sqlite
db/*.sqlite-*
db/*.db-journal
db/*.db-wal
db/*.db-shm

# CDS build cache
.cds-build/
.build/

# Logs
*.log
*logs*.txt
recent_logs*.txt
router_logs*.txt
approuter-logs.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env
.env.local
.env.*.local
default-env.json

# Approuter local-only env file (never deploy this; BTP injects real VCAP_SERVICES)
app/approuter/default-env.json

# MTA build artifacts
mta_archives/
mta-op-*/
.mta/
.temp_mtar/
Makefile_*.mta

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/settings.json
.idea/
*.iml
*.swp
*.swo

# Temporary files
*.tmp
*.temp
*.bak
*.cache
temp-*.js

# Runtime uploads
storage/attachments/

# Test coverage
coverage/
.nyc_output/
